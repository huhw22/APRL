# Copy to <workspace>/cluster.env, then source it from bash.
export APRL_WORKSPACE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
export APRL_DEPENDENCY_PREFIX="${APRL_DEPENDENCY_PREFIX:-/public/home/wfollowm/aprl_dev/aprl-runtime-lab}"
if [[ -f "$APRL_DEPENDENCY_PREFIX/share/aprl/runtime-env.sh" ]]; then
  source "$APRL_DEPENDENCY_PREFIX/share/aprl/runtime-env.sh"
fi
export PATH="/public/home/wfollowm/software/cmake-3.31.12/bin:$PATH"
export PYTHON_BIN="${PYTHON_BIN:-/public/home/wfollowm/micromamba/envs/physics/bin/python3}"
export APRL_SOURCE_DIR="$APRL_WORKSPACE/source/aprl"
export APRL_BASELINE_BUILD_DIR="$APRL_WORKSPACE/build/baseline"
export APRL_CANDIDATE_BUILD_DIR="$APRL_WORKSPACE/build/candidate"
export APRL_BASELINE="$APRL_BASELINE_BUILD_DIR/aprl"
export APRL_CANDIDATE="$APRL_CANDIDATE_BUILD_DIR/aprl"
export SASE_GENERATOR="$APRL_CANDIDATE_BUILD_DIR/sase_bunch_generator"
export PERFORMANCE_SUBMIT_DIR="$APRL_WORKSPACE/tests/performance"
export PARTITION="${PARTITION:-ssmb}"
export SRUN_MPI="${SRUN_MPI:-pmix_v3}"
# Existing experiment scripts accept these path overrides.
export APRL_BIN="$APRL_CANDIDATE"
export APRL_PROGRAM="$APRL_CANDIDATE"
export APRL_PROGRAM_DIR="$APRL_CANDIDATE_BUILD_DIR"
export CAMPAIGN_WORK_DIR="$APRL_WORKSPACE/results/sase_4m"
