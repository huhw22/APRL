#!/usr/bin/env bash
# APRL 4 m SASE exact-unit-weight test at dz_lab=1.35 nm, two nodes.

if [[ -z "${CAMPAIGN_DIR:-}" ]]; then
  CAMPAIGN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
fi
export CAMPAIGN_DIR

# Use an already-built APRL and the matching SASE generator. This campaign
# never compiles APRL itself.
APRL_PROGRAM="${APRL_PROGRAM:-}"
APRL_PROGRAM_DIR="${APRL_PROGRAM_DIR:-/public/home/wfollowm/aprl_dev/aprl-runtime-lab/bin}"
SASE_GENERATOR="${SASE_GENERATOR:-}"
APRL_RUNTIME_ENV="${APRL_RUNTIME_ENV:-}"
CAMPAIGN_WORK_DIR="${CAMPAIGN_WORK_DIR:-${CAMPAIGN_DIR}/work}"

# Laboratory Slurm environment.
MODULES="${MODULES:-}"
SBATCH_PARTITION="${SBATCH_PARTITION:-ssmb}"
SBATCH_ACCOUNT="${SBATCH_ACCOUNT:-}"
SBATCH_QOS="${SBATCH_QOS:-}"
NODES="${NODES:-2}"
TASKS_PER_NODE="${TASKS_PER_NODE:-128}"
WALLTIME="${WALLTIME:-48:0:0}"
SRUN_MPI="${SRUN_MPI:-pmix_v3}"
SRUN_TASK_EXIT_WAIT_SECONDS="${SRUN_TASK_EXIT_WAIT_SECONDS:-300}"
NODELIST="${NODELIST:-}"
EXCLUDE_NODES="${EXCLUDE_NODES:-}"
FORCE_RERUN="${FORCE_RERUN:-0}"
APRL_TEARDOWN_TRACE="${APRL_TEARDOWN_TRACE:-all}"

# This folder deliberately contains one production case only.
CASES="dz1p35-B0768"
CASE_SELECTION="${CASE_SELECTION:-}"

# Avoid the broken/unused OpenFabrics path on the laboratory nodes.
OMPI_MCA_btl="${OMPI_MCA_btl:-self,vader,tcp}"
OMPI_MCA_btl_openib_warn_no_device_params_found="${OMPI_MCA_btl_openib_warn_no_device_params_found:-0}"

# Match the completed 40 um, 170-period comparison except for the exact unit
# macro-particle weight. With 2951 wavelength cells, 8 quiet-start members
# per beamlet and 256 ranks, B=768 is the nearest exactly divisible choice:
# 2951 * 768 * 8 = 18,130,944 records/electrons, hence weight=1 exactly.
GAMMA_LAB="${GAMMA_LAB:-1174.169835810956}"
SIGMA_GAMMA="${SIGMA_GAMMA:-2.572263253829}"
UNDULATOR_K="${UNDULATOR_K:-1.092714657005}"
UNDULATOR_PERIOD_M="${UNDULATOR_PERIOD_M:-0.0234}"
UNDULATOR_PERIODS="${UNDULATOR_PERIODS:-170}"
RANDOM_SEED="${RANDOM_SEED:-20261005}"

BUNCH_LENGTH_M="${BUNCH_LENGTH_M:-40e-6}"
ELECTRONS="${ELECTRONS:-18130944}"
TARGET_REFERENCE_ELECTRONS="${TARGET_REFERENCE_ELECTRONS:-18000000}"
SIGMA_X_M="${SIGMA_X_M:-30e-6}"
SIGMA_Y_M="${SIGMA_Y_M:-30e-6}"
EMITTANCE_N_X_M="${EMITTANCE_N_X_M:-0.0}"
EMITTANCE_N_Y_M="${EMITTANCE_N_Y_M:-0.0}"
SASE_HARMONICS="${SASE_HARMONICS:-3}"
BEAMLETS_PER_WAVELENGTH="${BEAMLETS_PER_WAVELENGTH:-768}"
MACROPARTICLE_WEIGHT="${MACROPARTICLE_WEIGHT:-1}"

# Laboratory-equivalent z slicing. APRL receives dz_box=boost_gamma*dz_lab.
DZ_LAB_M="${DZ_LAB_M:-1.35e-9}"
MESH_DX_M="${MESH_DX_M:-5e-6}"
MESH_DY_M="${MESH_DY_M:-5e-6}"
MESH_NX="${MESH_NX:-104}"
MESH_NY="${MESH_NY:-104}"
MESH_DURATION_S="${MESH_DURATION_S:-5.0e-10}"
CPML_CELLS_XY="${CPML_CELLS_XY:-10}"
CPML_CELLS_Z="${CPML_CELLS_Z:-20}"

# These are the already-tested fine-grid values. They preserve the same
# physical guard and absorber thickness as the old 2.70 nm reference card.
AUTO_LOWER_GUARD_CELLS="${AUTO_LOWER_GUARD_CELLS:-64}"
AUTO_UPPER_GUARD_CELLS="${AUTO_UPPER_GUARD_CELLS:-128}"
AUTO_SELF_FIELD_PADDING_RMS="${AUTO_SELF_FIELD_PADDING_RMS:-0.0}"
AUTO_BALLISTIC_SAFETY="${AUTO_BALLISTIC_SAFETY:-1.1}"
AUTO_ALIGNMENT_CELLS="${AUTO_ALIGNMENT_CELLS:-256}"

INITIAL_FIELD_TOLERANCE="${INITIAL_FIELD_TOLERANCE:-1.0e-8}"
INITIAL_FIELD_MAXIMUM_ITERATIONS="${INITIAL_FIELD_MAXIMUM_ITERATIONS:-10000}"

INITIAL_CENTER_Z_M="${INITIAL_CENTER_Z_M:--0.05}"
ENTRY_PARTICLE_Z_M="${ENTRY_PARTICLE_Z_M:--0.03}"
EXIT_PARTICLE_Z_M="${EXIT_PARTICLE_Z_M:-4.03}"
PARTICLE_STEPS_PER_PERIOD="${PARTICLE_STEPS_PER_PERIOD:-80}"
MAXIMUM_PARTICLE_SUBSTEPS="${MAXIMUM_PARTICLE_SUBSTEPS:-4096}"
LEDGER_INTERVAL_STEPS="${LEDGER_INTERVAL_STEPS:-10}"
RESOURCE_PROGRESS_INTERVAL_STEPS="${RESOURCE_PROGRESS_INTERVAL_STEPS:-50}"
RESOURCE_CALIBRATION_STEPS="${RESOURCE_CALIBRATION_STEPS:-5}"
ENERGY_RESIDUAL_WARNING="${ENERGY_RESIDUAL_WARNING:-0.05}"
HDF5_COMPRESSION="${HDF5_COMPRESSION:-0}"

# Previous completed fine-grid B192 result, used only as a reporting baseline.
# The simulation never reads data from that old run.
REFERENCE_TAG="${REFERENCE_TAG:-dz1p35-B0192}"
REFERENCE_ELECTRONS="${REFERENCE_ELECTRONS:-18000000}"
REFERENCE_MACROPARTICLES="${REFERENCE_MACROPARTICLES:-4532736}"
REFERENCE_PEAK_RESIDUAL="${REFERENCE_PEAK_RESIDUAL:-0.0599180753}"
REFERENCE_FINAL_FIELD_ENERGY_J="${REFERENCE_FINAL_FIELD_ENERGY_J:-3.2741519e-9}"
REFERENCE_ELAPSED_S="${REFERENCE_ELAPSED_S:-61681.4944}"
REFERENCE_PEAK_RSS_MIB="${REFERENCE_PEAK_RSS_MIB:-80616.449}"
