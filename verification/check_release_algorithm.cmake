foreach(key APRL GENERATOR CARD WORK SHAPE)
  if(NOT DEFINED ${key})
    message(FATAL_ERROR "Missing release algorithm parameter ${key}")
  endif()
endforeach()
if(NOT WORK MATCHES "/verification/work/algorithm-")
  message(FATAL_ERROR "Release test output must stay in its dedicated verification directory")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(PARTICLE_FILE "${WORK}/particles.h5")
set(REFERENCE_DIR "${WORK}/reference")
set(ALGORITHM "  longitudinal_shape: ${SHAPE}")
configure_file("${CARD}" "${WORK}/run.yaml" @ONLY)
execute_process(COMMAND "${GENERATOR}" --output "${PARTICLE_FILE}"
  --length-m 1e-6 --current-A 0.001 --central-momentum-MeV-c 2
  --emit-x-m 1e-12 --emit-y-m 1e-12 --beta-x-m 1 --beta-y-m 1
  --sigma-dp 0 --overwrite RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Release input generator failed: ${output}${error}")
endif()
execute_process(COMMAND "${APRL}" "${WORK}/run.yaml" WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
file(WRITE "${WORK}/run.log" "${output}${error}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Production ${SHAPE} run failed: ${output}${error}")
endif()
file(READ "${WORK}/run-manifest.yaml" manifest)
if(NOT manifest MATCHES "aprl_version: 2.0.0" OR
   NOT manifest MATCHES "longitudinal_shape: ${SHAPE}")
  message(FATAL_ERROR "Installed version/kernel missing from manifest")
endif()
foreach(path detectors/field.h5 detectors/particles.h5 ledger/energy-ledger.h5)
  if(NOT EXISTS "${WORK}/${path}")
    message(FATAL_ERROR "Missing production output ${path}")
  endif()
endforeach()
message(STATUS "Production ${SHAPE} execution, version, selected kernel and detector/ledger output passed")
