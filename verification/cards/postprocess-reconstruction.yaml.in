input:
  field_file: "@APRL_VERIFY_WORK@/postprocess/signal/detectors/exit-field.h5"
  particle_file: "@APRL_VERIFY_WORK@/postprocess/signal/detectors/exit-particles.h5"
  require_complete: true
  particle_read_chunk: 16
model:
  fft_threads: 1
  padding_factor: [1, 1, 1]
  transverse_smoothing_m: 0.0
  maximum_relative_gamma_spread: 0.1
  maximum_rms_transverse_beta: 0.1
  maximum_outside_charge_fraction: 1.0
output:
  file: "@APRL_VERIFY_WORK@/postprocess/reconstructed.h5"
  compression: 0
  overwrite: true
