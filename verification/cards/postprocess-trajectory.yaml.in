input:
  require_complete: true
  read_chunk_records: 32
  shots:
    - name: smoke
      files: ["@APRL_VERIFY_WORK@/postprocess/signal/trajectory/particles-rank-00000.h5"]
observation:
  axis: [0.0, 0.0, 1.0]
  horizontal: [1.0, 0.0, 0.0]
  distance_m: 1.0
  theta_x_rad: {min: -0.001, max: 0.001, count: 2}
  theta_y_rad: {min: -0.001, max: 0.001, count: 2}
spectrum:
  photon_energy_eV: {min: 1.0, max: 100.0, count: 3, spacing: linear}
calculation:
  frequency_block: 2
  theta_y_block: 1
  minimum_records_per_particle: 3
output:
  file: "@APRL_VERIFY_WORK@/postprocess/trajectory-radiation.h5"
  compression: 0
  overwrite: true
